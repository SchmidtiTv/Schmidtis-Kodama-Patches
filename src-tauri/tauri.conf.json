{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kodama",
  "version": "1.0.0-alpha.34",
  "identifier": "dev.kodama.music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": [
        "main-capability",
        "sidecar-capability",
        "composer-capability"
      ],
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' ipc: http://ipc.localhost http://localhost:9847 http://127.0.0.1:9847 https://translate.googleapis.com https://api.github.com https://raw.githubusercontent.com https://kodama-stats.kiyoshidesign.workers.dev; img-src 'self' data: https: http: blob:; media-src 'self' file: blob: https:; font-src 'self' tauri: data: https://fonts.gstatic.com; frame-src http://localhost:*"
    },
    "windows": [
      {
        "label": "main",
        "title": "Kodama",
        "width": 1100,
        "height": 700,
        "minWidth": 1040,
        "minHeight": 560,
        "fullscreen": false,
        "resizable": true,
        "decorations": false
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kodama"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0NEQ4NjBDMTE0QUFGOTYKUldTV3Iwb1JESVpOaEozYVpHdzd0b1dBcHVKNjlpUDh3YSs4WFNVNDdpOEVvK0RQSUQyeVpzN04K",
      "endpoints": [
        "https://raw.githubusercontent.com/SchmidtiTv/Kodama/main/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/kodama-server"
    ],
    "macOS": {
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 900,
          "height": 520
        },
        "appPosition": {
          "x": 250,
          "y": 260
        },
        "applicationFolderPosition": {
          "x": 600,
          "y": 260
        }
      }
    },
    "resources": {
      "../public/App-Icons/*.png": "App-Icons/"
    }
  }
}
